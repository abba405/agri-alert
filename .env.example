# Copy to .env and fill in. Never commit .env.
AT_USERNAME=sandbox
AT_API_KEY=
# Leave empty in the sandbox. In production use your approved sender ID.
AT_SENDER_ID=
APP_NAME=AgriAlert
ADMIN_KEY=change-me
PORT=3000
RAIN_THRESHOLD=60
DB_PATH=./agri.db

# Optional, used by smoke-test.js and the Voice / Mobile Data steps
VOICE_FROM=
MOBILE_DATA_PRODUCT=
